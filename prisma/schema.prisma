// Prisma schema for Trackline
// Datasource is Postgres via DATABASE_URL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Minimal manual models to enable Prisma Client without introspection.
// These map to existing tables in db/supabase_seed.sql on Supabase.

model Quarter {
  id      Int  @id @default(autoincrement())
  year    Int
  quarter Int

  // Relations
  objectives Objective[]

  @@map("quarters")
  @@unique([year, quarter])
}

model Objective {
  id              String   @id @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  organization_id String   @db.Uuid
  title           String
  description     String?
  owner_id        String?  @db.Uuid
  department_id   String?  @db.Uuid
  status          String
  priority        String
  quarter_id      Int?
  progress        Int
  start_date      DateTime? @db.Date
  due_date        DateTime? @db.Date
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @default(now()) @db.Timestamptz

  // Relations
  quarter         Quarter?  @relation(fields: [quarter_id], references: [id])

  @@map("objectives")
}